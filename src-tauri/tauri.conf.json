{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "电子黄历",
  "version": "0.1.0",
  "identifier": "com.paida.electronic-almanac",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "tray-card",
        "title": "今日黄历",
        "url": "index.html?view=tray-card",
        "width": 360,
        "height": 500,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "电子黄历",
        "url": "index.html?view=main",
        "width": 620,
        "height": 760,
        "minWidth": 560,
        "minHeight": 680,
        "visible": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
